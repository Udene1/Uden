{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Uden Desktop Release Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "product", "version", "tag", "channel", "commit", "publishedAt", "artifacts", "rollout"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "product": { "type": "string", "const": "uden-desktop" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
    "tag": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
    "channel": { "type": "string", "enum": ["stable", "beta", "nightly"] },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "publishedAt": { "type": "string", "format": "date-time" },
    "minimumSupportedVersion": { "type": "string" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "platform", "arch", "filename", "url", "sha256"],
        "properties": {
          "id": { "type": "string" },
          "platform": { "type": "string", "enum": ["windows", "macos", "linux"] },
          "arch": { "type": "string", "enum": ["x64", "arm64", "universal"] },
          "filename": { "type": "string" },
          "url": { "type": "string", "format": "uri", "pattern": "^https://" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "rollout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "percentage"],
      "properties": {
        "state": { "type": "string", "enum": ["paused", "active", "complete"] },
        "percentage": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    }
  }
}
