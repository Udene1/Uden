{
  "name": "@ai-work-partner/engine",
  "version": "1.0.0",
  "private": true,
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:record": "node scripts/record_tests.mjs",
    "db:migrate:local": "wrangler d1 execute DB --local --file=src/db/schema.sql",
    "db:migrate:graph:local": "wrangler d1 execute DB --local --file=migrations/0002_task_graph_persistence.sql",
    "db:migrate:graph:durable:local": "wrangler d1 execute DB --local --file=migrations/0003_graph_durable_execution.sql",
    "db:migrate:budget:local": "wrangler d1 execute DB --local --file=migrations/0004_budget_reservations.sql",
    "db:migrate:permissions:local": "wrangler d1 execute DB --local --file=migrations/0005_permissions_audit.sql",
    "db:migrate:google:local": "wrangler d1 execute DB --local --file=migrations/0006_google_workspace.sql",
    "db:migrate:workspace:local": "wrangler d1 execute DB --local --file=migrations/0007_workspace_runtime.sql",
    "db:migrate:github:local": "wrangler d1 execute DB --local --file=migrations/0008_github_connector.sql",
    "db:migrate:patches:local": "wrangler d1 execute DB --local --file=migrations/0009_project_patches.sql",
    "db:migrate:approvals:local": "wrangler d1 execute DB --local --file=migrations/0010_graph_node_approvals.sql",
    "db:migrate:runtime-linkage:local": "wrangler d1 execute DB --local --file=migrations/0011_runtime_job_linkage.sql",
    "db:migrate:objectives:local": "wrangler d1 execute DB --local --file=migrations/0012_autonomous_objectives.sql",
    "db:migrate:verification-repair:local": "wrangler d1 execute DB --local --file=migrations/0013_graph_verification_repair.sql",
    "db:migrate:remote": "wrangler d1 execute DB --remote --file=src/db/schema.sql",
    "db:migrate:graph:remote": "wrangler d1 execute DB --remote --file=migrations/0002_task_graph_persistence.sql",
    "db:migrate:graph:durable:remote": "wrangler d1 execute DB --remote --file=migrations/0003_graph_durable_execution.sql",
    "db:migrate:budget:remote": "wrangler d1 execute DB --remote --file=migrations/0004_budget_reservations.sql",
    "db:migrate:permissions:remote": "wrangler d1 execute DB --remote --file=migrations/0005_permissions_audit.sql",
    "db:migrate:google:remote": "wrangler d1 execute DB --remote --file=migrations/0006_google_workspace.sql",
    "db:migrate:workspace:remote": "wrangler d1 execute DB --remote --file=migrations/0007_workspace_runtime.sql",
    "db:migrate:github:remote": "wrangler d1 execute DB --remote --file=migrations/0008_github_connector.sql",
    "db:migrate:patches:remote": "wrangler d1 execute DB --remote --file=migrations/0009_project_patches.sql",
    "db:migrate:approvals:remote": "wrangler d1 execute DB --remote --file=migrations/0010_graph_node_approvals.sql",
    "db:migrate:runtime-linkage:remote": "wrangler d1 execute DB --remote --file=migrations/0011_runtime_job_linkage.sql",
    "db:migrate:objectives:remote": "wrangler d1 execute DB --remote --file=migrations/0012_autonomous_objectives.sql",
    "db:migrate:verification-repair:remote": "wrangler d1 execute DB --remote --file=migrations/0013_graph_verification_repair.sql"
  },
  "dependencies": { "hono": "^4.0.0", "@hono/zod-validator": "^0.2.0", "zod": "^3.22.4", "@ai-work-partner/shared": "*", "@cloudflare/sandbox": "@next" },
  "devDependencies": { "wrangler": "^3.0.0", "@cloudflare/workers-types": "^4.20240222.0", "vitest": "^1.3.1", "typescript": "^5.3.3" }
