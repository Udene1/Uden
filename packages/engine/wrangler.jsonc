{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-work-partner-engine",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "ai-work-partner-db", "database_id": "00000000-0000-0000-0000-000000000000" }
  ],
  "kv_namespaces": [
    { "binding": "CACHE_KV", "id": "00000000-0000-0000-0000-000000000000" }
  ],
  "queues": {
    "producers": [
      { "binding": "TASK_GRAPH_QUEUE", "queue": "uden-task-graphs" }
    ],
    "consumers": [
      { "queue": "uden-task-graphs", "max_batch_size": 1, "max_batch_timeout": 5, "max_retries": 8, "retry_delay": 30, "dead_letter_queue": "uden-task-graphs-dlq", "max_concurrency": 5 }
    ]
  }
}
